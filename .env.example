# Base URL of the NotebookLM web app used for internal RPC calls
NOTEBOOKLM_BASE_URL=
# Optional JSON map to hot-patch NotebookLM RPC IDs if Google changes them
NOTEBOOKLM_RPC_OVERRIDES=
# MASTER_SECRET: one long random string (>= 32 characters); derives vault + signing keys. The explicit keys below are then optional
MASTER_SECRET=
# Optional when MASTER_SECRET is set (explicit value wins). 32-byte key (base64) for AES-256-GCM encryption of stored Google sessions
VAULT_ENCRYPTION_KEY=
# Version label of the current vault key, for key rotation (required with VAULT_ENCRYPTION_KEY; defaults to 1 with MASTER_SECRET)
VAULT_KEY_VERSION=
# Optional JSON map {"<version>": "<base64 key>"} of previous vault keys, for rotation
VAULT_PREVIOUS_KEYS=
# Owner passphrase (any long passphrase; set as a Sensitive variable). Protects login, vault pages and approval screen
OWNER_PASSPHRASE=
# Optional alternative: scrypt hash of the passphrase (takes precedence when set)
OWNER_PASSPHRASE_HASH=
# Supabase project URL (server side only)
SUPABASE_URL=
# Supabase service role key (server side only, never exposed to the client)
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret header value required by cron routes
CRON_SECRET=
# Optional when MASTER_SECRET is set (explicit value wins). Secret (at least 32 characters) used to sign OAuth tokens and, via a derived key, the owner session cookie
OAUTH_SIGNING_KEY=
# Public HTTPS base URL of this deployment (used in OAuth metadata)
PUBLIC_BASE_URL=
# Optional: comma-separated extra hostnames (https only) allowed as OAuth redirect hosts besides claude.ai / claude.com (loopback http is always allowed)
OAUTH_EXTRA_REDIRECT_HOSTS=
